# Copy to .env and adjust. docker compose reads .env automatically.

# --- Postgres ---
POSTGRES_USER=bakery
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bakerydb
POSTGRES_PORT=5432

# --- Backend (Go) — repo: bakery-golang ---
# Path to the sibling repo checkout, relative to this compose file.
BACKEND_CONTEXT=../bakery-golang
# dev = hot reload (air), prod = compiled static binary
BACKEND_TARGET=dev
BACKEND_PORT=8080
# Image tag. For local builds leave as-is; in CI set to a registry tag
# e.g. registry.example.com/bakery/golang:1.4.2 and use `docker compose pull`.
BACKEND_IMAGE=bakery-golang:local

# --- Frontend (Angular) — repo: bakery-angular ---
FRONTEND_CONTEXT=../bakery-angular
# dev = ng serve, prod = static build served by nginx
FRONTEND_TARGET=prod
FRONTEND_PORT=4200
FRONTEND_IMAGE=bakery-angular:local

# --- Kafka (optional, start with --profile kafka) ---
KAFKA_PORT=9092
